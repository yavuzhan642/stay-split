# Copy to .env.local and adjust. Never commit real credentials.

# Accommodation data source. Only "mock" (simulated demo data) exists for now.
ACCOMMODATION_PROVIDER=mock

# Artificial delay per mock provider call, in ms, to see loading states in the UI.
MOCK_PROVIDER_LATENCY_MS=0

# Deadline for one provider call before it counts as failed (100–60000).
PROVIDER_TIMEOUT_MS=8000

# Extra attempts after a temporary failure such as a timeout or rate limit (0–5).
PROVIDER_MAX_RETRIES=2

# How long prices may be reused, in seconds (0 disables the cache, max 3600).
QUOTE_CACHE_TTL_SECONDS=120
